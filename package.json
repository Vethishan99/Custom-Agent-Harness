{
  "name": "agent-harness-tui",
  "version": "0.2.1",
  "description": "A terminal coding agent for any codebase that works with Anthropic, OpenAI, OpenRouter, Gemini, Ollama and other providers.",
  "type": "module",
  "bin": {
    "agent-harness": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/cli.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "anthropic",
    "claude",
    "openai",
    "openrouter",
    "ollama"
  ],
  "author": "Vethishan",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vethishan99/Custom-Agent-Harness.git"
  },
  "homepage": "https://github.com/Vethishan99/Custom-Agent-Harness#readme",
  "bugs": {
    "url": "https://github.com/Vethishan99/Custom-Agent-Harness/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "chalk": "^5.6.2",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
