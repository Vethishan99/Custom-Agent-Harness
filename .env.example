# Used by `npm run dev`. Set the key for any one provider; the agent
# picks the first one it finds (Anthropic, OpenAI, OpenRouter, Gemini, ...).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional overrides.
# AGENT_HARNESS_PROVIDER=openrouter
# AGENT_HARNESS_MODEL=openrouter/free
